# Sao chép thành BE/.env. Chỉ đặt thông tin xác thực và khóa bí mật tại đây.
DB_USERNAME=root
DB_PASSWORD=
JWT_SECRET=replace_with_a_long_random_secret
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=FuLe BaberShop
MAIL_ENCRYPTION=tls

# Cổng thanh toán SePay: dùng khóa sandbox khi SEPAY_ENVIRONMENT=sandbox.
SEPAY_ENVIRONMENT=sandbox
SEPAY_MERCHANT_ID=
SEPAY_SECRET_KEY=
SEPAY_SUCCESS_URL=
SEPAY_ERROR_URL=
SEPAY_CANCEL_URL=
# Secret riêng để xác thực IPN, không dùng SEPAY_SECRET_KEY thay thế.
SEPAY_IPN_SECRET=
