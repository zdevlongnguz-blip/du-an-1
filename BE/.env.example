# Sao chép thành BE/.env. Chỉ đặt thông tin xác thực và khóa bí mật tại đây.
DB_USERNAME=root
DB_PASSWORD=
JWT_SECRET=replace_with_a_long_random_secret

# URL công khai khi chia sẻ qua ngrok hoặc deploy, dạng https://ten-mien (không có đường dẫn).
# Link trong email xác minh/đặt lại mật khẩu dùng giá trị này; để trống thì suy ra từ request.
# Khi FE và BE cùng origin (đường dẫn gọn / và /BE) thì FRONTEND_URL tự lấy theo APP_URL.
APP_URL=
# Chỉ cần khai báo khi FE chạy ở origin khác BE (mặc định http://localhost:5173 khi APP_URL trống).
FRONTEND_URL=
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=FuLe BaberShop
MAIL_ENCRYPTION=tls

# Cổng thanh toán SePay: dùng khóa sandbox khi SEPAY_ENVIRONMENT=sandbox.
SEPAY_ENVIRONMENT=sandbox
SEPAY_MERCHANT_ID=
SEPAY_SECRET_KEY=
# URL SePay chuyển trình duyệt về sau khi thanh toán. NÊN ĐỂ TRỐNG: khi trống, BE tự dùng
# FRONTEND_URL (= APP_URL khi chia sẻ qua ngrok) + /payment/success|error|cancel.
# Nếu điền cứng localhost thì người dùng ngoài máy bạn sẽ bị chuyển về localhost của chính họ và báo lỗi.
SEPAY_SUCCESS_URL=
SEPAY_ERROR_URL=
SEPAY_CANCEL_URL=
# Secret riêng để xác thực IPN, không dùng SEPAY_SECRET_KEY thay thế.
# Khai báo cùng giá trị này ở trang quản trị SePay (kiểu xác thực Secret Key). URL IPN: <APP_URL>/BE/?action=api-sepay-ipn
SEPAY_IPN_SECRET=
