# Copy thành .env.local để ghi đè cấu hình trên máy riêng (file này không được commit).

# Đường dẫn gốc nơi FE được phục vụ. Dùng / để URL gọn: https://ten-mien/catalog.
VITE_BASE_PATH=/

# URL gốc của BE mà FE gọi API và lấy ảnh. Có thể là đường dẫn tương đối (cùng origin)
# hoặc URL đầy đủ (khác host, BE phải bật CORS). Dev dùng /api để đi qua proxy của Vite.
VITE_API_BASE_URL=/BE

# Chỉ dùng khi chạy npm run dev: BE mà proxy /api của Vite chuyển tiếp tới.
VITE_API_PROXY_TARGET=http://du-an-1.test/BE
